#!/usr/bin/env bash
# =============================================================================
# coderun - run source files in 26 languages with one command.
#
# GENERATED FILE - DO NOT EDIT.
# Source modules live in src/unix/ and are concatenated by scripts/build.sh.
# Edit the modules, then run: ./scripts/build.sh
#
# Module order:
#   src/unix/10-config.sh
#   src/unix/20-output.sh
#   src/unix/30-languages.sh
#   src/unix/40-help.sh
#   src/unix/50-completions.sh
#   src/unix/60-info.sh
#   src/unix/70-update.sh
#   src/unix/80-compile.sh
#   src/unix/90-run.sh
#   src/unix/95-cli.sh
#   src/unix/99-main.sh
# =============================================================================

# shellcheck shell=bash
# shellcheck disable=SC2034
# =============================================================================
# 10-config.sh - Version, paths, platform detection, and shared state
#
# This module is loaded first. It defines every constant that the rest of the
# runner needs and detects the platform-specific compiler and installer paths.
# =============================================================================

# Keep in sync with the VERSION file. scripts/release.sh updates this line.
CODERUN_VERSION="2.4.1"

# Base URL used by --check-update and --update. Override it for testing or to
# point at a mirror. The runner appends /main or /v<version> to this value.
CODERUN_RAW_BASE="${CODERUN_RAW_BASE:-https://raw.githubusercontent.com/pjprogrammers/coderun}"

# Default installation directory. The installers use the same location.
INSTALL_DIR="$HOME/.local/bin"

# Platform-specific settings. Linux and macOS share this runner; only the
# C/C++ compiler, download path, installer hint, and shell configs differ.
case "$(uname -s 2>/dev/null)" in
    Darwin)
        C_COMPILER="clang"
        CPP_COMPILER="clang++"
        RUNNER_PATH="bin/coderun-mac"
        INSTALLER_HINT="./install-mac.sh"
        CONFIG_FILES=("$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bashrc")
        ;;
    *)
        C_COMPILER="gcc"
        CPP_COMPILER="g++"
        RUNNER_PATH="bin/coderun"
        INSTALLER_HINT="./install.sh"
        CONFIG_FILES=("$HOME/.bashrc")
        ;;
esac

# Temporary files created by update and version-check operations. The EXIT
# trap makes sure a failed operation never leaves files behind.
TEMP_FILE=""
CHECKSUM_FILE=""
LATEST_VERSION=""

cleanup_temp() {
    if [ -n "$TEMP_FILE" ]; then
        rm -f "$TEMP_FILE"
    fi
    if [ -n "$CHECKSUM_FILE" ]; then
        rm -f "$CHECKSUM_FILE"
    fi
}

trap cleanup_temp EXIT

# Set by the -q/--quiet flag. All informational output goes through log_info,
# which honours this flag.
QUIET=0

# shellcheck shell=bash
# =============================================================================
# 20-output.sh - Logging and timing helpers
#
# Small, dependency-free helpers shared by the command, compile, and run
# modules. Keeping them here avoids duplicating formatting logic.
# =============================================================================

# Print an informational message unless --quiet was requested.
log_info() {
    if [ "$QUIET" -eq 0 ]; then
        echo "$@"
    fi
}

# Lowercase a string. Used for case-insensitive extensions and language names.
lowercase() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Print the current time in milliseconds.
#
# Uses the first available high-resolution clock. The final fallback only has
# second precision, but it keeps --time working on minimal systems.
now_ms() {
    local value

    if value="$(date +%s%N 2>/dev/null)" && [[ "$value" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$((value / 1000000))"
        return
    fi

    if command -v perl >/dev/null 2>&1; then
        perl -MTime::HiRes=time -e 'printf "%.0f\n", time * 1000'
        return
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import time; print(int(time.time() * 1000))'
        return
    fi

    printf '%s000\n' "$(date +%s)"
}

# Print elapsed milliseconds in seconds with three decimal places.
# Timing output goes to stderr so it never mixes with program output.
report_elapsed() {
    local start="$1"
    local end
    local elapsed

    end="$(now_ms)"
    elapsed=$((end - start))

    if [ "$elapsed" -lt 0 ]; then
        elapsed=0
    fi

    printf 'coderun: %d.%03ds\n' "$((elapsed / 1000))" "$((elapsed % 1000))" >&2
}

# shellcheck shell=bash
# shellcheck disable=SC2034
# =============================================================================
# 30-languages.sh - Language registry, lookup, and dependency checks
#
# The LANGUAGES table is the single source of truth for supported languages.
# Every other module asks this file to translate an extension, language name,
# or tool name into a language record.
#
# Record format:
#   id|display name|extensions|type|required tools
#
# Extensions and tools are space-separated. The first extension spelling is
# used for display.
# =============================================================================

LANGUAGES=(
    "c|C|c|compiled|$C_COMPILER"
    "cpp|C++|cpp|compiled|$CPP_COMPILER"
    "python|Python|py|interpreted|python3"
    "r|R|r R|interpreted|Rscript"
    "java|Java|java|compiled|java javac"
    "rust|Rust|rs|compiled|rustc"
    "javascript|JavaScript|js|interpreted|node"
    "typescript|TypeScript|ts|interpreted|tsx"
    "go|Go|go|compiled|go"
    "php|PHP|php|interpreted|php"
    "ruby|Ruby|rb|interpreted|ruby"
    "bash|Bash|sh|interpreted|bash"
    "swift|Swift|swift|compiled|swift swiftc"
    "kotlin|Kotlin|kt|compiled|kotlinc java"
    "lua|Lua|lua|interpreted|lua"
    "perl|Perl|pl|interpreted|perl"
    "julia|Julia|jl|interpreted|julia"
    "dart|Dart|dart|interpreted|dart"
    "elixir|Elixir|exs|interpreted|elixir"
    "zig|Zig|zig|compiled|zig"
    "nim|Nim|nim|compiled|nim"
    "fortran|Fortran|f90 f95 f03 f08 for f|compiled|gfortran"
    "pascal|Pascal|pas|compiled|fpc"
    "crystal|Crystal|cr|compiled|crystal"
    "csharp|C#|cs|interpreted|dotnet"
    "fsharp|F#|fsx fs|interpreted|dotnet"
)

LANGUAGE_COUNT="${#LANGUAGES[@]}"

# Populated by missing_tools. Callers must read it immediately after the call.
MISSING_TOOLS=""

# Populated by find_language and resolve_extension.
LANG_ID=""
LANG_NAME=""
LANG_TYPE=""
LANG_TOOLS=""

# Store a language record in the shared LANG_* variables.
set_language() {
    LANG_ID="$1"
    LANG_NAME="$2"
    LANG_TYPE="$3"
    LANG_TOOLS="$4"
}

# Find the first missing command from a space-separated tool list.
# Sets MISSING_TOOLS to a space-separated list (empty when everything exists).
missing_tools() {
    local tools="$1"
    local cmd
    local missing=""

    for cmd in $tools; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing="$missing $cmd"
        fi
    done

    MISSING_TOOLS="${missing# }"
}

# Turn "py R" into ".py, .R".
format_extensions() {
    local exts="$1"
    local ext
    local result=""

    for ext in $exts; do
        if [ -z "$result" ]; then
            result=".$ext"
        else
            result="$result, .$ext"
        fi
    done

    printf '%s' "$result"
}

# Print the language table. With verbose=1, also report whether each
# language's required tools are installed.
show_languages() {
    local verbose="$1"
    local spec id name exts type tools status

    echo "Supported languages:"
    echo

    if [ "$verbose" -eq 1 ]; then
        printf '  %-12s %-25s %-12s %s\n' "Language" "Extensions" "Type" "Status"
    else
        printf '  %-12s %-25s %s\n' "Language" "Extensions" "Type"
    fi

    for spec in "${LANGUAGES[@]}"; do
        IFS='|' read -r id name exts type tools <<< "$spec"

        if [ "$verbose" -eq 1 ]; then
            missing_tools "$tools"
            if [ -z "$MISSING_TOOLS" ]; then
                status="installed"
            else
                status="missing: $MISSING_TOOLS"
            fi
            printf '  %-12s %-25s %-12s %s\n' "$name" "$(format_extensions "$exts")" "$type" "$status"
        else
            printf '  %-12s %-25s %s\n' "$name" "$(format_extensions "$exts")" "$type"
        fi
    done
}

# Resolve a language id, display name, extension, or tool name.
#
# Examples: "python", "Python", "py", ".py", and "python3" all resolve to
# Python. On success the LANG_* variables are set and the function returns 0.
find_language() {
    local target
    local spec id name exts type tools
    local ext

    target="$(lowercase "$1")"
    target="${target#.}"

    # Common aliases that are not language ids or extensions.
    case "$target" in
        golang) target="go" ;;
        js) target="javascript" ;;
        ts) target="typescript" ;;
        cxx) target="cpp" ;;
        py) target="python" ;;
    esac

    for spec in "${LANGUAGES[@]}"; do
        IFS='|' read -r id name exts type tools <<< "$spec"

        if [ "$(lowercase "$id")" = "$target" ] || [ "$(lowercase "$name")" = "$target" ]; then
            set_language "$id" "$name" "$type" "$tools"
            return 0
        fi

        for ext in $exts; do
            if [ "$(lowercase "$ext")" = "$target" ]; then
                set_language "$id" "$name" "$type" "$tools"
                return 0
            fi
        done

        for ext in $tools; do
            if [ "$(lowercase "$ext")" = "$target" ]; then
                set_language "$id" "$name" "$type" "$tools"
                return 0
            fi
        done
    done

    return 1
}

# Resolve a file extension (without the leading dot) to a language record.
resolve_extension() {
    local target
    local spec id name exts type tools
    local ext

    target="$(lowercase "$1")"

    for spec in "${LANGUAGES[@]}"; do
        IFS='|' read -r id name exts type tools <<< "$spec"

        for ext in $exts; do
            if [ "$(lowercase "$ext")" = "$target" ]; then
                set_language "$id" "$name" "$type" "$tools"
                return 0
            fi
        done
    done

    return 1
}

# Check one language or every language.
#
# With no target, the check is informational and exits 0 unless strict=1.
# With a target, the check fails when that language is unknown or incomplete.
check_dependencies() {
    local target="$1"
    local strict="$2"
    local spec id name exts type tools
    local available=0
    local failures=0

    if [ -n "$target" ]; then
        if ! find_language "$target"; then
            echo "Unknown language: $target"
            echo "Run 'coderun --list' to see supported languages."
            return 1
        fi

        missing_tools "$LANG_TOOLS"
        if [ -z "$MISSING_TOOLS" ]; then
            printf '%s: ok\n' "$LANG_NAME"
            return 0
        fi

        printf '%s: missing: %s\n' "$LANG_NAME" "$MISSING_TOOLS"
        return 1
    fi

    echo "Checking required compilers and runtimes:"
    echo

    for spec in "${LANGUAGES[@]}"; do
        IFS='|' read -r id name exts type tools <<< "$spec"
        missing_tools "$tools"

        if [ -z "$MISSING_TOOLS" ]; then
            printf '  %-13s ok\n' "$name"
            available=$((available + 1))
        else
            printf '  %-13s missing: %s\n' "$name" "$MISSING_TOOLS"
            failures=$((failures + 1))
        fi
    done

    echo
    echo "$available of $LANGUAGE_COUNT language toolchains are available."

    if [ "$strict" -eq 1 ] && [ "$failures" -ne 0 ]; then
        echo "Some dependencies are missing. Install the missing tools and try again."
        return 1
    fi

    if [ "$strict" -eq 0 ]; then
        echo "Run 'coderun --check <language>' to require a specific toolchain."
    fi

    return 0
}

# shellcheck shell=bash
# =============================================================================
# 40-help.sh - The --help text
#
# Keep this text in sync with the README and with the Windows runner. The
# tests assert that key options and languages are mentioned.
# =============================================================================

show_help() {
    echo "coderun $CODERUN_VERSION"
    echo
    cat <<'EOF'
Usage:
  coderun [options] <file> [program args...]
  coderun --compile <file>
  coderun --clean <file>
  coderun -o <output> <file> [program args...]
  coderun --check [language] [--strict]

Run source files in 26 languages with one command.
Everything after <file> is passed to the program unchanged.

Help:
  -h, --help           Show this help message
  -v, --version        Show the installed version

Information:
      --list           List supported languages
      --list --verbose List languages and whether their tools are installed
      --check          Check required compilers and runtimes (exit 0)
      --check <lang>   Check one language (exit 1 when it is missing)
      --check --strict Exit 1 when any dependency is missing
      --info           Show system and installation information
      --check-update   Check for a newer coderun release

Maintenance:
      --update         Update coderun to the latest version
      --uninstall      Remove coderun from this system
      --completions <shell>
                       Print completions (bash, zsh, fish, powershell)

Execution:
      --compile        Compile without running
      --clean          Remove generated build artifacts
  -o, --output <file>  Set the output artifact for compiled languages
      --runtime <name> Use node, bun, or deno for JavaScript/TypeScript
      --time           Report elapsed time after running or compiling
  -q, --quiet          Suppress coderun's own informational messages

Supported languages:
  C (.c), C++ (.cpp), Python (.py), R (.R, .r), Java (.java),
  Rust (.rs), JavaScript (.js), TypeScript (.ts), Go (.go), PHP (.php),
  Ruby (.rb), Bash (.sh), Swift (.swift), Kotlin (.kt), Lua (.lua),
  Perl (.pl), Julia (.jl), Dart (.dart), Elixir (.exs), Zig (.zig),
  Nim (.nim), Fortran (.f90), Pascal (.pas), Crystal (.cr), C# (.cs),
  F# (.fsx, .fs)

Examples:
  coderun main.cpp
  coderun main.py --verbose
  coderun main.cpp input.txt
  coderun --compile main.cpp
  coderun -o app main.cpp --port 8080
  coderun --runtime bun app.ts
  coderun --clean main.cpp
  coderun --check python
  coderun --check --strict

Note: The required compiler or runtime must be installed and on PATH.
EOF
}

# shellcheck shell=bash
# =============================================================================
# 50-completions.sh - Shell completion generators
#
# Each branch prints a self-contained completion script. Users can install the
# output with their shell's normal completion mechanism.
# =============================================================================

show_completions() {
    case "$1" in
        bash)
            cat <<'EOF'
# bash completion for coderun
_coderun() {
    local cur opts
    cur="${COMP_WORDS[COMP_CWORD]}"
    opts="-h --help -v --version --list --verbose --check --strict --info --check-update --update --uninstall --compile --clean -o --output --runtime --time -q --quiet --completions"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    fi
    COMPREPLY+=( $(compgen -f -- "$cur") )
}
complete -F _coderun coderun
EOF
            ;;
        zsh)
            cat <<'EOF'
#compdef coderun
_coderun() {
    _arguments \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-v --version)'{-v,--version}'[show version]' \
        '--list[list supported languages]' \
        '--verbose[show tool status with --list]' \
        '--check[check toolchains]' \
        '--strict[fail when tools are missing]' \
        '--info[show system information]' \
        '--check-update[check for a newer release]' \
        '--update[update coderun]' \
        '--uninstall[remove coderun]' \
        '--compile[compile only]' \
        '--clean[remove build artifacts]' \
        '(-o --output)'{-o,--output}'[set output artifact]:file:_files' \
        '--runtime[choose JavaScript/TypeScript runtime]:runtime:(node bun deno)' \
        '--time[report elapsed time]' \
        '(-q --quiet)'{-q,--quiet}'[suppress informational messages]' \
        '--completions[print completions]:shell:(bash zsh fish powershell)' \
        '*:file:_files'
}
_coderun "$@"
EOF
            ;;
        fish)
            cat <<'EOF'
# fish completion for coderun
complete -c coderun -f
complete -c coderun -s h -l help -d 'Show help'
complete -c coderun -s v -l version -d 'Show version'
complete -c coderun -l list -d 'List supported languages'
complete -c coderun -l verbose -d 'Show tool status with --list'
complete -c coderun -l check -d 'Check toolchains'
complete -c coderun -l strict -d 'Fail when tools are missing'
complete -c coderun -l info -d 'Show system information'
complete -c coderun -l check-update -d 'Check for updates'
complete -c coderun -l update -d 'Update coderun'
complete -c coderun -l uninstall -d 'Remove coderun'
complete -c coderun -l compile -d 'Compile only'
complete -c coderun -l clean -d 'Remove build artifacts'
complete -c coderun -s o -l output -r -d 'Set output artifact'
complete -c coderun -l runtime -r -a 'node bun deno' -d 'Choose runtime'
complete -c coderun -l time -d 'Report elapsed time'
complete -c coderun -s q -l quiet -d 'Suppress informational messages'
complete -c coderun -l completions -r -a 'bash zsh fish powershell' -d 'Print completions'
complete -c coderun -F
EOF
            ;;
        powershell|pwsh)
            cat <<'EOF'
# PowerShell completion for coderun
Register-ArgumentCompleter -Native -CommandName coderun -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    $options = @(
        '-h', '--help', '-v', '--version', '--list', '--verbose', '--check',
        '--strict', '--info', '--check-update', '--update', '--uninstall',
        '--compile', '--clean', '-o', '--output', '--runtime', '--time',
        '-q', '--quiet', '--completions'
    )
    $options | Where-Object { $_ -like "$wordToComplete*" } |
        ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterName', $_)
        }
}
EOF
            ;;
        *)
            echo "Error: unknown shell: $1"
            echo "Supported shells: bash, zsh, fish, powershell."
            return 1
            ;;
    esac
}

# shellcheck shell=bash
# =============================================================================
# 60-info.sh - --info support
#
# Resolves the path of the running script (following symlinks) and prints the
# environment details users need when reporting a problem.
# =============================================================================

# Print the canonical path of this script, even when it was invoked through a
# symlink or found on PATH without a slash.
resolve_script_path() {
    local source="${BASH_SOURCE[0]}"
    local dir

    case "$source" in
        */*) ;;
        *)
            source="$(command -v -- "$source" 2>/dev/null || printf '%s' "$source")"
            ;;
    esac

    while [ -L "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
        source="$(readlink "$source")"
        case "$source" in
            /*) ;;
            *) source="$dir/$source" ;;
        esac
    done

    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
    printf '%s/%s\n' "$dir" "$(basename "$source")"
}

show_info() {
    local script_path
    local os_name
    local arch

    script_path="$(resolve_script_path)"
    os_name="$(uname -s 2>/dev/null || echo unknown)"
    arch="$(uname -m 2>/dev/null || echo unknown)"

    echo "coderun $CODERUN_VERSION"
    echo "Install path: $script_path"
    echo "Operating system: $os_name"
    echo "Architecture: $arch"
    echo "Shell: ${SHELL:-unknown}"
    echo "Languages: $LANGUAGE_COUNT"
    echo "Runner URL: $CODERUN_RAW_BASE/v$CODERUN_VERSION/$RUNNER_PATH"
}

# shellcheck shell=bash
# =============================================================================
# 70-update.sh - Update, version check, and uninstall support
#
# All network access lives in this module. Updates are verified in three ways
# before the installed runner is replaced:
#   1. The downloaded file must look like a coderun Bash script.
#   2. Its embedded version must match the announced release.
#   3. Its SHA-256 hash must match the published SHA256SUMS entry.
# =============================================================================

# Print the name of an available downloader, or return 1 when neither curl nor
# wget is installed.
choose_downloader() {
    if command -v curl >/dev/null 2>&1; then
        echo "curl"
    elif command -v wget >/dev/null 2>&1; then
        echo "wget"
    else
        return 1
    fi
}

# Download a URL to a destination path. Returns 127 when no downloader exists.
download_file() {
    local url="$1"
    local destination="$2"
    local downloader

    downloader="$(choose_downloader)" || return 127

    if [ "$downloader" = "curl" ]; then
        curl -fsSL "$url" -o "$destination"
    else
        wget -qO "$destination" "$url"
    fi
}

# Print the SHA-256 hash of a file. Returns 1 when no hashing tool is available.
sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        return 1
    fi
}

# Return 0 when version $1 is newer than version $2. Versions are semver-like
# dotted triples; missing components are treated as zero.
version_greater() {
    local left="$1"
    local right="$2"
    local i
    local -a left_parts
    local -a right_parts

    IFS='.' read -r -a left_parts <<< "$left"
    IFS='.' read -r -a right_parts <<< "$right"

    for i in 0 1 2; do
        if [ "$((10#${left_parts[i]:-0}))" -gt "$((10#${right_parts[i]:-0}))" ]; then
            return 0
        fi
        if [ "$((10#${left_parts[i]:-0}))" -lt "$((10#${right_parts[i]:-0}))" ]; then
            return 1
        fi
    done

    return 1
}

# Read the published VERSION file into LATEST_VERSION.
# Sets TEMP_FILE and leaves cleanup to the EXIT trap.
fetch_latest_version() {
    local status

    TEMP_FILE="${TMPDIR:-/tmp}/coderun-version.$$"

    download_file "$CODERUN_RAW_BASE/main/VERSION" "$TEMP_FILE"
    status=$?

    if [ "$status" -eq 127 ]; then
        echo "Error: curl or wget is required to check for updates."
        return 1
    fi

    if [ "$status" -ne 0 ]; then
        echo "Error: could not check for updates."
        return 1
    fi

    LATEST_VERSION="$(tr -d '[:space:]' < "$TEMP_FILE")"

    if ! [[ "$LATEST_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "Error: could not read the latest version."
        return 1
    fi

    return 0
}

# Verify that a downloaded file is a coderun script with the expected version.
verify_downloaded_runner() {
    local path="$1"
    local expected_version="$2"
    local downloaded_version

    if [ "$(head -n 1 "$path")" != "#!/usr/bin/env bash" ]; then
        echo "Error: downloaded file does not look like a valid coderun script."
        return 1
    fi

    downloaded_version="$(sed -n 's/^CODERUN_VERSION="\([0-9][0-9.]*\)"$/\1/p' "$path" | head -n 1)"

    if [ "$downloaded_version" != "$expected_version" ]; then
        echo "Error: downloaded runner version does not match $expected_version."
        return 1
    fi

    return 0
}

# Download SHA256SUMS and compare it with the downloaded runner.
verify_downloaded_checksum() {
    local path="$1"
    local checksums_url="$2"
    local expected
    local actual

    if ! download_file "$checksums_url" "$CHECKSUM_FILE"; then
        echo "Error: could not download SHA256SUMS for $LATEST_VERSION."
        return 1
    fi

    expected="$(awk -v path="$RUNNER_PATH" '$2 == path { print $1; exit }' "$CHECKSUM_FILE")"

    if [ -z "$expected" ]; then
        echo "Error: SHA256SUMS does not contain $RUNNER_PATH."
        return 1
    fi

    actual="$(sha256_file "$path")" || {
        echo "Error: sha256sum or shasum is required to verify updates."
        return 1
    }

    if [ "$(lowercase "$expected")" != "$(lowercase "$actual")" ]; then
        echo "Error: update checksum verification failed."
        return 1
    fi

    return 0
}

# Compare the installed version with the published VERSION file.
check_update() {
    echo "Current version: $CODERUN_VERSION"
    echo "Checking for updates..."

    fetch_latest_version || exit 1

    echo "Latest version: $LATEST_VERSION"

    if version_greater "$LATEST_VERSION" "$CODERUN_VERSION"; then
        echo "A new version is available. Run 'coderun --update' to install it."
        exit 1
    fi

    echo "coderun is up to date."
    exit 0
}

# Download, verify, and install the latest runner.
update_coderun() {
    local target="$INSTALL_DIR/coderun"
    local status
    local runner_url
    local checksums_url

    if [ ! -f "$target" ]; then
        echo "Error: coderun is not installed at $target."
        echo "Run $INSTALLER_HINT from the repository first."
        exit 1
    fi

    echo "Current version: $CODERUN_VERSION"
    echo "Checking for updates..."

    fetch_latest_version || exit 1

    echo "Latest version: $LATEST_VERSION"

    if ! version_greater "$LATEST_VERSION" "$CODERUN_VERSION"; then
        rm -f "$TEMP_FILE"
        TEMP_FILE=""
        echo "coderun is up to date ($CODERUN_VERSION)."
        exit 0
    fi

    rm -f "$TEMP_FILE"
    TEMP_FILE="$target.tmp.$$"
    CHECKSUM_FILE="${TMPDIR:-/tmp}/coderun-checksums.$$"

    runner_url="$CODERUN_RAW_BASE/v$LATEST_VERSION/$RUNNER_PATH"
    checksums_url="$CODERUN_RAW_BASE/v$LATEST_VERSION/SHA256SUMS"

    echo "Updating coderun to $LATEST_VERSION..."

    download_file "$runner_url" "$TEMP_FILE"
    status=$?

    if [ "$status" -eq 127 ]; then
        echo "Error: curl or wget is required to update coderun."
        exit 1
    fi

    if [ "$status" -ne 0 ]; then
        echo "Error: update download failed."
        exit 1
    fi

    verify_downloaded_runner "$TEMP_FILE" "$LATEST_VERSION" || exit 1
    verify_downloaded_checksum "$TEMP_FILE" "$checksums_url" || exit 1

    if ! chmod 755 "$TEMP_FILE" || ! mv "$TEMP_FILE" "$target"; then
        echo "Error: could not replace $target."
        exit 1
    fi

    rm -f "$CHECKSUM_FILE"
    CHECKSUM_FILE=""
    TEMP_FILE=""

    echo "coderun updated successfully to $LATEST_VERSION."
}

# Remove the coderun PATH line from one shell configuration file.
remove_path_entry() {
    local config="$1"
    local line='export PATH="$HOME/.local/bin:$PATH"'
    local temp="$config.coderun.$$"

    if [ ! -f "$config" ]; then
        return 0
    fi

    if grep -qF "$line" "$config" 2>/dev/null; then
        grep -vF "$line" "$config" > "$temp" 2>/dev/null || true
        cat "$temp" > "$config"
        rm -f "$temp"
        echo "Removed coderun PATH entry from $config"
    fi
}

# Remove the installed runner and clean up PATH when the install directory is
# left empty.
uninstall_coderun() {
    local target="$INSTALL_DIR/coderun"
    local removed=0
    local install_dir_empty=0
    local config

    if [ -f "$target" ]; then
        rm -f "$target"
        echo "Removed $target"
        removed=1
    fi

    if [ -d "$INSTALL_DIR" ]; then
        if [ -z "$(ls -A "$INSTALL_DIR" 2>/dev/null)" ]; then
            install_dir_empty=1
        fi
    else
        install_dir_empty=1
    fi

    if [ "$install_dir_empty" -eq 1 ]; then
        for config in "${CONFIG_FILES[@]}"; do
            remove_path_entry "$config"
        done

        rmdir "$INSTALL_DIR" 2>/dev/null || true
    else
        echo "Kept $INSTALL_DIR in PATH because it contains other files."
    fi

    if [ "$removed" -eq 0 ]; then
        echo "coderun was not installed at $target."
    else
        echo "coderun uninstalled successfully."
        echo "Open a new terminal to finish."
    fi
}

# shellcheck shell=bash
# shellcheck disable=SC2154
# =============================================================================
# 80-compile.sh - Artifact naming, compilation, and cleanup
#
# The compile module owns everything that produces or removes files on disk.
# It relies on the LANG_* variables set by resolve_extension and on the
# source-path variables set by the CLI module:
#   file, dir, name, base, ext, output_opt, COMPILE_OUTPUT
# =============================================================================

# Decide where a compiled artifact should be written.
#
# With -o/--output, the user's path wins. Kotlin gets a .jar suffix when the
# user did not provide one. Without -o, Java writes classes beside the source,
# Kotlin writes <base>.jar, and every other compiled language writes <base>.
compile_artifact() {
    if [ -n "$output_opt" ]; then
        case "$LANG_ID" in
            kotlin)
                case "${output_opt##*/}" in
                    *.*)
                        COMPILE_OUTPUT="$output_opt"
                        ;;
                    *)
                        COMPILE_OUTPUT="$output_opt.jar"
                        ;;
                esac
                ;;
            *)
                COMPILE_OUTPUT="$output_opt"
                ;;
        esac
    else
        case "$LANG_ID" in
            java)
                COMPILE_OUTPUT="$dir"
                ;;
            kotlin)
                COMPILE_OUTPUT="$dir/$base.jar"
                ;;
            *)
                COMPILE_OUTPUT="$dir/$base"
                ;;
        esac
    fi
}

# Turn a possibly relative artifact path into an absolute path.
resolve_output_path() {
    case "$1" in
        /*)
            printf '%s\n' "$1"
            ;;
        *)
            printf '%s/%s\n' "$(pwd)" "$1"
            ;;
    esac
}

# Compile the current source file to COMPILE_OUTPUT.
# Returns the compiler's exit status.
compile_file() {
    compile_artifact

    case "$LANG_ID" in
        cpp)
            "$CPP_COMPILER" "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
        c)
            "$C_COMPILER" "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
        java)
            javac "$file" -d "$dir"
            return $?
            ;;
        rust)
            rustc "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
        go)
            go build -o "$COMPILE_OUTPUT" "$file"
            return $?
            ;;
        swift)
            swiftc "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
        kotlin)
            kotlinc "$file" -include-runtime -d "$COMPILE_OUTPUT"
            return $?
            ;;
        zig)
            zig build-exe "$file" -femit-bin="$COMPILE_OUTPUT"
            return $?
            ;;
        nim)
            nim c --out:"$COMPILE_OUTPUT" "$file"
            return $?
            ;;
        fortran)
            gfortran "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
        pascal)
            fpc "$file" "-o$COMPILE_OUTPUT"
            return $?
            ;;
        crystal)
            crystal build "$file" -o "$COMPILE_OUTPUT"
            return $?
            ;;
    esac

    return 1
}

# State for clean_file. Reset on every call so the function can be reused.
CLEANED=0
CLEAN_FAILED=0

# Remove one artifact and record the outcome.
remove_artifact() {
    if [ -e "$1" ]; then
        if rm -f "$1"; then
            log_info "Removed $1"
            CLEANED=1
        else
            echo "Error: could not remove $1."
            CLEAN_FAILED=1
        fi
    fi
}

# Remove every artifact that the current language can generate for the source
# file, including custom output paths and Java inner classes.
clean_file() {
    local class_file
    local custom_artifact

    CLEANED=0
    CLEAN_FAILED=0

    if [ "$LANG_TYPE" = "interpreted" ]; then
        log_info "No build artifacts to clean for .$ext files (interpreted language)."
        return 0
    fi

    if [ -n "$output_opt" ]; then
        case "$LANG_ID" in
            kotlin)
                case "${output_opt##*/}" in
                    *.*)
                        custom_artifact="$output_opt"
                        ;;
                    *)
                        custom_artifact="$output_opt.jar"
                        ;;
                esac
                remove_artifact "$custom_artifact"
                ;;
            java)
                # Java has no custom artifact; class files go beside the source.
                ;;
            *)
                remove_artifact "$output_opt"
                ;;
        esac
    fi

    case "$LANG_ID" in
        c|cpp|rust|go|swift|fortran|pascal|crystal)
            remove_artifact "$dir/$base"
            ;;
        kotlin)
            remove_artifact "$dir/$base.jar"
            ;;
        zig)
            remove_artifact "$dir/$base"
            remove_artifact "$dir/$base.o"
            ;;
        nim)
            remove_artifact "$dir/$base"
            ;;
        java)
            remove_artifact "$dir/$base.class"
            for class_file in "$dir/$base"\$*.class; do
                if [ -e "$class_file" ]; then
                    remove_artifact "$class_file"
                fi
            done
            ;;
    esac

    if [ "$CLEANED" -eq 0 ]; then
        log_info "No build artifacts found for $file."
    fi

    if [ "$CLEAN_FAILED" -ne 0 ]; then
        return 1
    fi

    return 0
}

# shellcheck shell=bash
# shellcheck disable=SC2154
# =============================================================================
# 90-run.sh - Program execution dispatch
#
# Interpreted languages call their interpreter directly. Compiled languages
# either compile and run an artifact, or use a tool that compiles and runs in
# one step (go run, swift, zig run, nim r, crystal run).
# =============================================================================

# Run JavaScript with the selected runtime. Defaults to node.
run_javascript() {
    local runtime="${runtime_opt:-node}"

    case "$runtime" in
        node)
            node "$file" "$@"
            ;;
        bun)
            bun run "$file" "$@"
            ;;
        deno)
            deno run "$file" "$@"
            ;;
    esac
}

# Run TypeScript with the selected runtime. Defaults to tsx.
run_typescript() {
    local runtime="${runtime_opt:-tsx}"

    case "$runtime" in
        node)
            node "$file" "$@"
            ;;
        bun)
            bun run "$file" "$@"
            ;;
        deno)
            deno run "$file" "$@"
            ;;
        tsx)
            tsx "$file" "$@"
            ;;
    esac
}

# Run a compiled language.
#
# With -o/--output we must compile first, then execute the requested artifact.
# Without it, languages with a combined compile-and-run command use that
# command; the rest compile to the default artifact and execute it.
run_compiled() {
    local target

    if [ -n "$output_opt" ]; then
        compile_file || return $?

        if [ "$LANG_ID" = "kotlin" ]; then
            java -jar "$COMPILE_OUTPUT" "$@"
            return $?
        fi

        target="$(resolve_output_path "$COMPILE_OUTPUT")"
        "$target" "$@"
        return $?
    fi

    case "$LANG_ID" in
        c|cpp|rust|fortran|pascal)
            compile_file || return $?
            target="$(resolve_output_path "$COMPILE_OUTPUT")"
            "$target" "$@"
            return $?
            ;;
        kotlin)
            compile_file || return $?
            java -jar "$COMPILE_OUTPUT" "$@"
            return $?
            ;;
        go)
            go run "$file" "$@"
            return $?
            ;;
        swift)
            swift "$file" "$@"
            return $?
            ;;
        zig)
            zig run "$file" -- "$@"
            return $?
            ;;
        nim)
            nim r "$file" -- "$@"
            return $?
            ;;
        crystal)
            crystal run "$file" -- "$@"
            return $?
            ;;
    esac

    return 1
}

# Run any supported source file. Program arguments are passed through
# unchanged.
run_file() {
    case "$LANG_ID" in
        python)
            python3 "$file" "$@"
            return $?
            ;;
        r)
            Rscript "$file" "$@"
            return $?
            ;;
        javascript)
            run_javascript "$@"
            return $?
            ;;
        typescript)
            run_typescript "$@"
            return $?
            ;;
        php)
            php "$file" "$@"
            return $?
            ;;
        ruby)
            ruby "$file" "$@"
            return $?
            ;;
        bash)
            bash "$file" "$@"
            return $?
            ;;
        lua)
            lua "$file" "$@"
            return $?
            ;;
        perl)
            perl "$file" "$@"
            return $?
            ;;
        julia)
            julia "$file" "$@"
            return $?
            ;;
        dart)
            dart run "$file" "$@"
            return $?
            ;;
        elixir)
            elixir "$file" "$@"
            return $?
            ;;
        csharp)
            if [ $# -gt 0 ]; then
                dotnet run "$file" -- "$@"
            else
                dotnet run "$file"
            fi
            return $?
            ;;
        fsharp)
            dotnet fsi "$file" "$@"
            return $?
            ;;
        java)
            java "$file" "$@"
            return $?
            ;;
        c|cpp|rust|go|swift|kotlin|zig|nim|fortran|pascal|crystal)
            run_compiled "$@"
            return $?
            ;;
    esac

    return 1
}

# shellcheck shell=bash
# shellcheck disable=SC2034
# =============================================================================
# 95-cli.sh - Command-line parsing, validation, and dispatch
#
# This module is the control centre. It keeps a small amount of global state
# because Bash functions cannot return structured values cleanly. The contract
# is:
#
#   Parsing fills:
#     mode, action, output_opt, runtime_opt, check_target, check_strict,
#     list_verbose, time_it, completion_shell, file, program_args
#
#   Validation adds:
#     dir, name, base, ext, LANG_ID, LANG_NAME, LANG_TYPE, LANG_TOOLS
#
#   Execution consumes all of the above and exits with the program or
#     compiler exit code.
# =============================================================================

mode="run"
action=""
output_opt=""
runtime_opt=""
check_target=""
check_strict=0
list_verbose=0
time_it=0
completion_shell=""
file=""
program_args=()

# Select run/compile/clean mode. Compile and clean are mutually exclusive.
set_mode() {
    if [ "$mode" != "run" ] && [ "$mode" != "$1" ]; then
        echo "Error: --compile and --clean cannot be used together."
        exit 1
    fi
    mode="$1"
}

# Select a top-level action. Two different actions cannot be combined.
set_action() {
    if [ -n "$action" ] && [ "$action" != "$1" ]; then
        echo "Error: --$action and --$1 cannot be combined."
        exit 1
    fi
    action="$1"
}

# Parse coderun options until the source file is reached. Everything after the
# source file belongs to the program, except for one optional -- separator.
parse_arguments() {
    while [ $# -gt 0 ]; do
        if [ -n "$file" ]; then
            if [ "${#program_args[@]}" -eq 0 ] && [ "$1" = "--" ]; then
                shift
            fi
            if [ $# -gt 0 ]; then
                program_args=("$@")
            fi
            break
        fi

        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "coderun $CODERUN_VERSION"
                exit 0
                ;;
            --list)
                set_action "list"
                ;;
            --verbose)
                list_verbose=1
                ;;
            --check)
                set_action "check"
                ;;
            --strict)
                check_strict=1
                ;;
            --info)
                set_action "info"
                ;;
            --check-update)
                set_action "check-update"
                ;;
            --update)
                set_action "update"
                ;;
            --uninstall)
                set_action "uninstall"
                ;;
            --completions)
                if [ $# -lt 2 ] || [ -z "$2" ]; then
                    echo "Error: --completions requires a shell name."
                    exit 1
                fi
                set_action "completions"
                completion_shell="$2"
                shift
                ;;
            --compile)
                set_mode "compile"
                ;;
            --clean)
                set_mode "clean"
                ;;
            -o|--output)
                if [ $# -lt 2 ] || [ -z "$2" ]; then
                    echo "Error: $1 requires an output path."
                    exit 1
                fi
                output_opt="$2"
                shift
                ;;
            --runtime)
                if [ $# -lt 2 ] || [ -z "$2" ]; then
                    echo "Error: --runtime requires a value: node, bun, or deno."
                    exit 1
                fi
                runtime_opt="$2"
                shift
                ;;
            --time)
                time_it=1
                ;;
            -q|--quiet)
                QUIET=1
                ;;
            --)
                shift
                if [ $# -gt 0 ]; then
                    file="$1"
                    shift
                fi
                if [ $# -gt 0 ]; then
                    program_args=("$@")
                fi
                break
                ;;
            -*)
                echo "Unknown option: $1"
                echo "Try 'coderun --help' for more information."
                exit 1
                ;;
            *)
                if [ "$action" = "check" ] && [ -z "$check_target" ]; then
                    check_target="$1"
                else
                    file="$1"
                fi
                ;;
        esac

        shift
    done
}

# Handle a top-level action (--list, --check, --info, etc.).
# Returns immediately when no action was requested; otherwise it exits.
handle_action() {
    if [ -z "$action" ]; then
        return 0
    fi

    if [ "$mode" != "run" ]; then
        echo "Error: --$action cannot be combined with --compile or --clean."
        exit 1
    fi

    if [ -n "$output_opt" ]; then
        echo "Error: --$action cannot be combined with -o/--output."
        exit 1
    fi

    if [ "$action" != "check" ] && [ "$action" != "list" ] && [ -n "$file" ]; then
        echo "Error: unexpected argument: $file"
        exit 1
    fi

    case "$action" in
        list)
            if [ -n "$file" ] || [ -n "$check_target" ]; then
                echo "Error: unexpected argument: ${file:-$check_target}"
                exit 1
            fi
            show_languages "$list_verbose"
            exit 0
            ;;
        check)
            if [ -n "$file" ]; then
                echo "Error: unexpected argument: $file"
                exit 1
            fi
            check_dependencies "$check_target" "$check_strict"
            exit $?
            ;;
        info)
            show_info
            exit 0
            ;;
        check-update)
            check_update
            exit $?
            ;;
        update)
            update_coderun
            exit 0
            ;;
        uninstall)
            uninstall_coderun
            exit 0
            ;;
        completions)
            show_completions "$completion_shell"
            exit $?
            ;;
    esac
}

# Split the source path into directory, filename, base name, and extension.
resolve_source_path() {
    dir="."
    name="$file"

    case "$file" in
        */*)
            dir="${file%/*}"
            name="${file##*/}"
            if [ -z "$dir" ]; then
                dir="/"
            fi
            ;;
    esac

    base="${name%.*}"
    ext="${name##*.}"
    ext="$(lowercase "$ext")"
}

# Validate --runtime and store a normalized value.
validate_runtime() {
    if [ -z "$runtime_opt" ]; then
        return 0
    fi

    case "$runtime_opt" in
        node|bun|deno)
            ;;
        *)
            echo "Error: unknown runtime: $runtime_opt"
            echo "Supported runtimes: node, bun, deno."
            exit 1
            ;;
    esac

    case "$LANG_ID" in
        javascript|typescript)
            ;;
        *)
            echo "Error: --runtime is only supported for JavaScript and TypeScript."
            exit 1
            ;;
    esac
}

# Validate -o/--output against the selected language.
validate_output() {
    if [ -z "$output_opt" ]; then
        return 0
    fi

    case "$LANG_ID" in
        java)
            echo "Error: -o/--output is not supported for Java."
            exit 1
            ;;
    esac

    if [ "$LANG_TYPE" != "compiled" ]; then
        echo "Error: -o/--output is only supported for compiled languages."
        exit 1
    fi

    if [ "$output_opt" = "$file" ]; then
        echo "Error: output path must not be the source file."
        exit 1
    fi
}

# Validate flag combinations, the source file, and language-specific options.
validate_invocation() {
    if [ "$list_verbose" -eq 1 ]; then
        echo "Error: --verbose can only be used with --list."
        exit 1
    fi

    if [ "$check_strict" -eq 1 ]; then
        echo "Error: --strict can only be used with --check."
        exit 1
    fi

    if [ "$mode" = "compile" ] || [ "$mode" = "clean" ]; then
        if [ -z "$file" ]; then
            echo "Error: --$mode requires a source file."
            exit 1
        fi
    fi

    if [ -z "$file" ]; then
        if [ -n "$output_opt" ]; then
            echo "Error: -o/--output requires a source file."
            exit 1
        fi

        show_help
        exit 1
    fi

    if [ ! -f "$file" ]; then
        echo "Error: file not found: $file"
        exit 1
    fi

    resolve_source_path

    if ! resolve_extension "$ext"; then
        echo "Unsupported file type: .$ext"
        echo "Run 'coderun --list' to see supported languages."
        exit 1
    fi

    validate_runtime
    validate_output
}

# Compile-only mode. Reports the artifact and exits with the compiler status.
execute_compile() {
    local start_time=0
    local status

    if [ "${#program_args[@]}" -gt 0 ]; then
        echo "Error: --compile does not accept program arguments."
        exit 1
    fi

    if [ "$LANG_TYPE" != "compiled" ]; then
        echo "Error: cannot compile .$ext files; this language is interpreted."
        echo "Use 'coderun \"$file\"' to run it directly."
        exit 1
    fi

    if [ "$time_it" -eq 1 ]; then
        start_time="$(now_ms)"
    fi

    compile_file
    status=$?

    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi

    if [ "$time_it" -eq 1 ]; then
        report_elapsed "$start_time"
    fi

    if [ "$LANG_ID" = "java" ]; then
        log_info "Compiled $file -> $dir (Java class files)"
    else
        log_info "Compiled $file -> $COMPILE_OUTPUT"
    fi

    exit 0
}

# Run mode. Times the program when requested and preserves its exit code.
execute_run() {
    local start_time=0
    local status

    if [ "$time_it" -eq 1 ]; then
        start_time="$(now_ms)"
    fi

    run_file "${program_args[@]}"
    status=$?

    if [ "$time_it" -eq 1 ]; then
        report_elapsed "$start_time"
    fi

    exit "$status"
}

# Dispatch to clean, compile, or run.
execute() {
    local status

    if [ "$mode" = "clean" ]; then
        if [ "${#program_args[@]}" -gt 0 ]; then
            echo "Error: --clean does not accept program arguments."
            exit 1
        fi

        clean_file
        status=$?
        exit "$status"
    fi

    if [ "$mode" = "compile" ]; then
        execute_compile
    fi

    execute_run
}

# Entry point for the generated runner.
main() {
    parse_arguments "$@"
    handle_action
    validate_invocation
    execute
}

# shellcheck shell=bash
# =============================================================================
# 99-main.sh - Entry point
#
# Every module above defines constants and functions. This final line starts
# the CLI. Keeping the call in its own module makes the generated runner's
# entry point obvious and keeps module loading free of side effects.
# =============================================================================

main "$@"
