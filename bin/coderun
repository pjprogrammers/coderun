```bash
#!/usr/bin/env bash

if [ $# -eq 0 ]; then
    echo "Usage: coderun <file>"
    exit 1
fi

file="$1"

if [ ! -f "$file" ]; then
    echo "Error: file not found: $file"
    exit 1
fi

dir="$(dirname "$file")"
name="$(basename "$file")"
base="${name%.*}"
ext="${name##*.}"

case "$ext" in
    cpp)
        g++ "$file" -o "$dir/$base" && "$dir/$base"
        ;;
    c)
        gcc "$file" -o "$dir/$base" && "$dir/$base"
        ;;
    py)
        python3 "$file"
        ;;
    R|r)
        Rscript "$file"
        ;;
    java)
        java "$file"
        ;;
    rs)
        rustc "$file" -o "$dir/$base" && "$dir/$base"
        ;;
    js)
        node "$file"
        ;;
    ts)
        tsx "$file"
        ;;
    go)
        go run "$file"
        ;;
    php)
        php "$file"
        ;;
    rb)
        ruby "$file"
        ;;
    sh)
        bash "$file"
        ;;
    swift)
        swift "$file"
        ;;
    kt)
        kotlinc "$file" -include-runtime -d "$dir/$base.jar" && java -jar "$dir/$base.jar"
        ;;
    *)
        echo "Unsupported file type: .$ext"
        echo "Supported: .py .cpp .c .R .r .java .rs .js .ts .go .php .rb .sh .swift .kt"
        exit 1
        ;;
esac
```
